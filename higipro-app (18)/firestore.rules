rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared synchronization store for HigiPro across PC and mobile devices
    match /sync_stores/{storeId} {
      allow read: if isValidId(storeId);
      allow create, update: if isValidId(storeId) && request.resource.data.size() > 0;
      allow delete: if false;
    }
  }
}
